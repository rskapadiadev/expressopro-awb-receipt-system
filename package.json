{
    "name": "expresspro-awb-receipt-system",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "npm run build && vite preview",
        "deploy": "npm run build && wrangler deploy",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix",
        "format": "eslint . --fix; prettier --write .",
        "typecheck": "tsc -b",
        "test": "vitest run",
        "db:generate": "drizzle-kit generate",
        "db:migrate:local": "wrangler d1 migrations apply DB --local",
        "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
        "db:seed:local": "tsx scripts/seed.ts",
        "db:seed:remote": "tsx scripts/seed.ts --remote",
        "prepare": "husky",
        "check:size": "npm run build && wrangler deploy --dry-run"
    },
    "lint-staged": {
        "*.{ts,tsx,js,mjs}": [
            "eslint --fix --max-warnings 0",
            "prettier --write"
        ],
        "*.{json,css,md}": "prettier --write"
    },
    "dependencies": {
        "@hookform/resolvers": "^6.0.1",
        "@tanstack/react-query": "^5.105.0",
        "@tanstack/react-router": "^1.170.46",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "drizzle-orm": "^0.45.4",
        "hono": "^4.13.14",
        "jsbarcode": "^3.12.3",
        "lucide-react": "^1.62.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-hook-form": "^7.91.0",
        "react-rnd": "^10.5.3",
        "tailwind-merge": "^3.7.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.65.0",
        "@cloudflare/workers-types": "^4.20260702.1",
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "drizzle-kit": "^0.31.11",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "prettier": "^3.9.10",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.23.15",
        "typescript": "~6.0",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.5",
        "vitest": "^4.1.12",
        "wrangler": "^4.86.0"
    },
    "allowScripts": {
        "esbuild@0.28.2": true,
        "esbuild@0.18.20": true,
        "esbuild@0.25.12": true,
        "esbuild@0.27.3": true,
        "workerd@1.20261019.1": true,
        "workerd@1.20260426.1": true,
        "fsevents@2.3.3": true
    }
}
