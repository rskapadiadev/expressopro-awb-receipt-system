{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "expresspro-awb",
    "main": "worker/index.ts",
    "compatibility_date": "2026-10-01",
    "assets": {
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"],
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "expresspro-awb",
            // Replace with the id printed by `wrangler d1 create expresspro-awb`.
            "database_id": "00000000-0000-0000-0000-000000000000",
            "migrations_dir": "migrations",
        },
    ],
    "observability": {
        "enabled": true,
    },
    // Custom subdomain (DNS must be on Cloudflare):
    // "routes": [{ "pattern": "receipts.yourdomain.com", "custom_domain": true }]
}
