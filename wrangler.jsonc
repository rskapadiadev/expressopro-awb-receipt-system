{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "receipts",
    "main": "worker/index.ts",
    "compatibility_date": "2026-10-01",
    "assets": {
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"],
    },
    "d1_databases": [
        {
            // `npm run dev` uses a local copy; only --remote commands and deploys touch this database.
            "binding": "DB",
            "database_name": "expressopro-awb",
            "database_id": "6b4044e8-e6e7-4655-8716-4cbd3606cf3c",
            "migrations_dir": "migrations",
        },
    ],
    "observability": {
        "enabled": true,
    },
    // Custom subdomain (DNS must be on Cloudflare):
    // "routes": [{ "pattern": "receipts.yourdomain.com", "custom_domain": true }]
}
